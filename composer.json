{
    "name": "rapiddive/nrql-builder",
    "description": "Query builder for New Relic Query Language (NRQL) with API client support for REST and GraphQL",
    "type": "library",
    "keywords": ["newrelic", "nrql", "query-builder", "graphql", "nerdgraph", "insights", "monitoring"],
    "require": {
        "php": ">=8.0",
        "nesbot/carbon": "^3.8",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "license": "Apache-2.0",
    "autoload": {
        "psr-4": {
            "Rapiddive\\NrqlBuilder\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Rapid Dive",
            "email": "rapiddive1@gmail.com"
        }
    ],
    "autoload-dev": {
        "psr-4": {
            "Rapiddive\\": "test/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9",
        "symfony/polyfill": "^1.30"
    },
    "suggest": {
        "guzzlehttp/guzzle": "For using PSR-18 HTTP client instead of cURL",
        "symfony/http-client": "For using Symfony HTTP client"
    }
}
